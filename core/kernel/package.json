{
  "name": "andromeda-core-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "start:local": "set PORT=4001&& tsx src/index.ts",
    "migrate": "drizzle-kit migrate",
    "benchmark": "autocannon -c 10 -d 20 http://localhost:4000/api/metrics",
    "benchmark:full": "npm run benchmark"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.1.4",
    "drizzle-orm": "^0.16.1",
    "drizzle-orm-pg": "^0.16.3",
    "fastify": "^4.25.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.1",
    "pgvector": "^0.2.1",
    "pino": "^8.20.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/supertest": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "prisma": "^6.6.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.13.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.2"
  }
}
