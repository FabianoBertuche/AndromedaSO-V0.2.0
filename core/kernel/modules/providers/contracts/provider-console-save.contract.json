{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider Console Save Payload",
  "type": "object",
  "required": ["variant"],
  "properties": {
    "variant": {
      "type": "string",
      "enum": ["ollama", "openai-api", "openai-oauth"]
    },
    "name": { "type": "string" },
    "selectedModelIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "config": {
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "baseUrl": { "type": "string" },
        "organization": { "type": "string" }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["api-key", "base-url", "oauth-manual"]
        },
        "callbackUrl": { "type": "string" },
        "code": { "type": "string" },
        "state": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
