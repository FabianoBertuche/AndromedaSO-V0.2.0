{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTemplateManifest",
  "description": "Contract defining the structure of an agent template manifest",
  "type": "object",
  "required": [
    "templateId",
    "name",
    "group",
    "variant",
    "version",
    "config"
  ],
  "properties": {
    "templateId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the template"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the template"
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "description": "Group the template belongs to"
    },
    "variant": {
      "type": "string",
      "minLength": 1,
      "description": "Variant within the group"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version of the template"
    },
    "status": {
      "type": "string",
      "enum": ["active", "disabled", "deprecated"],
      "default": "active"
    },
    "metadata": {
      "type": "object",
      "default": {},
      "description": "Additional metadata about the template"
    },
    "config": {
      "type": "object",
      "description": "Base configuration for agents created from this template"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "operationalParameters": {
          "type": "object",
          "default": {},
          "description": "Default operational parameters"
        }
      },
      "default": {}
    },
    "tests": {
      "type": "object",
      "default": {},
      "description": "Test configuration for the template"
    },
    "scenarios": {
      "type": "object",
      "default": {},
      "description": "Scenario configurations for the template"
    }
  }
}
