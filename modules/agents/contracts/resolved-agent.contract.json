{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResolvedAgentConfig",
  "description": "Contract defining the structure of a resolved agent configuration",
  "type": "object",
  "required": [
    "agentId",
    "templateId",
    "sourceTemplateId",
    "name",
    "slug",
    "role",
    "goal",
    "personality",
    "tone",
    "responseStyle",
    "systemInstructions",
    "restrictions",
    "securityRules",
    "defaultLanguage",
    "tags",
    "status",
    "visibility",
    "allowedChannels",
    "enabledCapabilities",
    "operationalParameters",
    "resolutionTrace",
    "configHash"
  ],
  "properties": {
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceTemplateId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "personality": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "responseStyle": {
      "type": "string",
      "minLength": 1
    },
    "systemInstructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "securityRules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defaultLanguage": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "disabled"]
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "team", "public"]
    },
    "preferredModel": {
      "type": ["string", "null"]
    },
    "compatibleModelStrategy": {
      "type": ["string", "null"]
    },
    "allowedChannels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabledCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operationalParameters": {
      "type": "object",
      "additionalProperties": true
    },
    "bindings": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      },
      "default": {}
    },
    "resolutionTrace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceType", "sourceId"],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": ["template", "template-defaults", "agent-overrides", "operational-parameters", "bindings"]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "configHash": {
      "type": "string",
      "minLength": 1,
      "description": "Hash of the resolved configuration for traceability"
    }
  }
}
