{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentInstance",
  "description": "Contract defining the structure of an agent instance",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "templateId",
    "sourceTemplateId",
    "role",
    "goal",
    "personality",
    "tone",
    "responseStyle",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceTemplateId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "disabled"],
      "default": "active"
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "team", "public"],
      "default": "private"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "personality": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "responseStyle": {
      "type": "string",
      "minLength": 1
    },
    "systemInstructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "securityRules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "defaultLanguage": {
      "type": "string",
      "minLength": 1,
      "default": "pt-BR"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "preferredModel": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "compatibleModelStrategy": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "allowedChannels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "enabledCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "overrides": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "role": { "type": "string" },
        "goal": { "type": "string" },
        "personality": { "type": "string" },
        "tone": { "type": "string" },
        "responseStyle": { "type": "string" },
        "systemInstructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "restrictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "securityRules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "defaultLanguage": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preferredModel": { "type": ["string", "null"] },
        "compatibleModelStrategy": { "type": ["string", "null"] },
        "allowedChannels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enabledCapabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "operationalParameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "default": {}
    },
    "deletedAt": {
      "type": ["string", "null"],
      "default": null
    },
    "version": {
      "type": "number",
      "minimum": 1,
      "default": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
